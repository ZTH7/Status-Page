{
  "name": "cfstatuspage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "cf-types": "wrangler types src/worker-configuration.d.ts",
    "config:generate": "tsx scripts/generate-config.ts",
    "prepare:generated": "npm run config:generate && npm run cf-types",
    "predev": "npm run prepare:generated",
    "prebuild": "npm run prepare:generated",
    "pretypecheck": "npm run prepare:generated",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "pretest:app": "npm run config:generate",
    "test:app": "vitest run --config vitest.app.config.ts",
    "pretest:worker": "npm run prepare:generated",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test": "npm run test:unit && npm run test:app && npm run test:worker",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:legacy": "tsx scripts/migrate-legacy-kv.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
